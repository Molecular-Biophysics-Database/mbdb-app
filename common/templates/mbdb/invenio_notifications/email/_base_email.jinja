{# Shared base layout for MBDB notification emails #}

{# --- layout constants --- #}
{% set CONTENT_WIDTH = 600 %}
{% set FONT_STACK = "Arial, sans-serif" %}
{% set TEXT_COLOR = "#333" %}
{% set FONT_SIZE = "14px" %}
{% set LINE_HEIGHT = "1.5" %}
{% set TEXT_ALIGN = TEXT_ALIGN | default("center") %}

{% import "mbdb/invenio_notifications/email/_macros.jinja" as m %}

{%- block subject -%}{%- endblock subject -%}

{%- block html_body -%}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td align="center">
      <table role="presentation" width="{{ CONTENT_WIDTH }}" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="font-family:{{ FONT_STACK }}; font-size:{{ FONT_SIZE }}; color:{{ TEXT_COLOR }}; line-height:{{ LINE_HEIGHT }}; text-align:{{ TEXT_ALIGN }};">
            {%- block html_content -%}{%- endblock html_content -%}
          </td>
        </tr>
      </table>

      {# spacer #}
      <table role="presentation" width="{{ CONTENT_WIDTH }}" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="line-height:20px; font-size:1px;">&nbsp;</td>
        </tr>
      </table>

      {# signature #}
      <table role="presentation" width="{{ CONTENT_WIDTH }}" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="padding:0 0 20px 0;">
            {% include "mbdb/invenio_notifications/email/html-email-signature.jinja" %}
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
{%- endblock html_body -%}

{%- block plain_body -%}
{%- block plain_content -%}{%- endblock plain_content -%}

{% include "mbdb/invenio_notifications/email/plain-email-signature.jinja" %}
{%- endblock plain_body -%}

{# Optional: Slack/Mattermost/chat #}
{%- block md_body -%}{%- endblock md_body -%}
