{% import "mbdb/invenio_notifications/email/_macros.jinja" as m %}

{% macro render_html(body, text_align="center", width=600) -%}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td align="center">
      <table role="presentation" width="{{ width }}" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="font-family:Arial, sans-serif; font-size:14px; color:#333; line-height:1.5; text-align:{{ text_align }};">
            {{ body }}
          </td>
        </tr>
      </table>

      <table role="presentation" width="{{ width }}" cellpadding="0" cellspacing="0" border="0">
        <tr><td style="line-height:20px; font-size:1px;">&nbsp;</td></tr>
      </table>

      <table role="presentation" width="{{ width }}" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="padding:0 0 20px 0;">
            {% include "mbdb/invenio_notifications/email/html-email-signature.jinja" %}
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
{%- endmacro %}

{% macro render_plain(body) -%}
{{ body }}

{% include "mbdb/invenio_notifications/email/plain-email-signature.jinja" %}
{%- endmacro %}
