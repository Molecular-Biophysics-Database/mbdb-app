{% set request = notification.context.request %}
{% set topic = request.topic %}
{% set rec_info = topic.metadata.general_parameters.record_information %}

{% set topic_id = topic.id %}
{% set topic_title = rec_info.title %}
{% set method = rec_info.resource_type %}

{% set request_html_page = request.links.self_html %}
{% set record_html_page = topic.links.self_html %}

{%- block subject -%}
    {{ _("PUBLISHED: Your MBDB record '{topic_id}' has been published")
      .format(topic_id=topic_id) }}
{%- endblock subject -%}

{%- block html_body -%}
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
           style="background-color:#f6f6f6; padding:20px 0;">
        <tr>
            <td align="center">
                <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"
                       style="background-color:#ffffff; padding:24px;
                        border-radius:6px; font-family:Arial, sans-serif;
                        font-size:14px; color:#333; line-height:1.5;">
                    <tr>
                        <td>
                            {% trans topic_title=topic_title, record_html_page=record_html_page %}
                                <p>
                                    <b>Congratulations!</b> Your record <b>"{{ topic_title }}"</b> has been successfully
                                    <b>PUBLISHED</b>.
                                </p>

                                <p>
                                    The record is now available <a href="{{ record_html_page }}"
                                                                   style="font-family:Arial, sans-serif; font-size:14px; color:#ffffff;
                  text-decoration:none; display:inline-block;">HERE</a>.
                                </p>

                                <table role="presentation" cellpadding="0" cellspacing="0" border="0"
                                       style="margin:20px 0;">
                                    <tr>
                                        <td bgcolor="#28a745" align="center"
                                            style="padding:12px 24px; border-radius:4px;">
                                            Thank you for your contribution!
                                        </td>
                                    </tr>
                                </table>
                            {% endtrans %}
                        </td>
                    </tr>
                </table>

                <div style="margin-top:20px;">
                    {% include "mbdb/invenio_notifications/email/html-email-signature.jinja" %}
                </div>
            </td>
        </tr>
    </table>
{%- endblock html_body -%}

{%- block plain_body -%}
{% trans topic_title=topic_title, record_html_page=record_html_page %}
Congratulations! Your record "{{ topic_title }}" has been successfully PUBLISHED.
The record is now available on the url below.

Thank you for your contribution!

{{ record_html_page }}
{% endtrans %}
{% include "mbdb/invenio_notifications/email/plain-email-signature.jinja" %}
{%- endblock plain_body -%}