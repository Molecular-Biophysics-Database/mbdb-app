{% set request = notification.context.request %}
{% set topic = request.topic %}
{% set topic_id = topic.id %}
{% set record_metadata = topic.get("metadata", {}) %}
{% set topic_title = record_metadata.get("title", topic_id) %}
{% set request_html_page = request.links.self_html %}

{%- block subject -%}
    {{ _("APPROVED: Your submission '{topic_title}' has been accepted for publication")
        .format(topic_title=topic_title)
    }}
{%- endblock subject -%}

{%- block html_body -%}
    {% trans topic_title=topic_title, link=request_html_page %}
    <p>
    🎉 **Great News!** Your record **"{{topic_title}}"** has successfully passed the review stage and has been **APPROVED for publication** by the repository staff.
    </p>
    <p>
    The submission is now in the **Accepted** state. Please visit the request page to view the final decision details and complete any final steps necessary to move your record to the public repository.
    </p>
    <p>
        <a type="button" href='{{link}}' style="display:inline-block;padding:10px 20px;background-color:#28a745;color:#ffffff;text-decoration:none;border-radius:5px;">View Final Status & Publish</a>
    </p>
    {% endtrans %}
{%- endblock html_body -%}

{%- block plain_body -%}
    {% trans topic_title=topic_title, link=request_html_page %}
    Great News! Your record "{{topic_title}}" has successfully passed review and has been APPROVED FOR PUBLICATION by the repository staff.

    The record is now in an 'Accepted' state. Please visit the request page to view the final status and complete any necessary steps to make the record public:
    {{link}}
    {% endtrans %}
{%- endblock plain_body -%}