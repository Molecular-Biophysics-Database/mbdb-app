//
// overrides for css styles. To reference a font/image from the assets directory, use:
// url("~@less/fonts/your-font-name") or url("~@less/images/your-image-name")
//
// Custom CSS reset by:
// https://www.joshwcomeau.com/css/custom-css-reset/
// https://github.com/inveniosoftware/invenio-app-rdm/blob/d21af4eac1f6aca4ddd524cccfb621ae259f8411/invenio_app_rdm/theme/assets/semantic-ui/less/invenio_app_rdm/theme/globals/site.overrides#L4


/* 1. Use a more-intuitive box-sizing model */
*, *::before, *::after {
  box-sizing: border-box;
}
/* 2. Remove default margin */
* {
  margin: 0;
}
html, body {
  /* 3. Add accessible line-height */
  line-height: 1.5;
  /* 4. Improve text rendering */
  -webkit-font-smoothing: antialiased;
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  font-size: @fontSize;
}

main {
  flex-grow: 1;
}

/* 5. Improve media defaults */
img, picture, video, canvas, svg {
  display: block;
  max-width: 100%;
}
/* 6. Inherit fonts for form controls */
input, button, textarea, select {
  font: inherit;
}
/* 7. Avoid text overflows */
p, h1, h2, h3, h4, h5, h6 {
  overflow-wrap: break-word;
}
/* 8. Improve line wrapping */
p {
  text-wrap: pretty;
}
h1, h2, h3, h4, h5, h6 {
  text-wrap: balance;
}
/*
  9. Create a root stacking context
*/
#root, #__next {
  isolation: isolate;
}


/* Override defaults from invenio-theme that cannot be overriden other way */
html.cover-page {
  background-color: @coverPageBackgroundColor !important;
}
.ui.page-header {
    #invenio-burger-menu-icon {
        .navicon, .navicon::before, .navicon::after {
            background: @white !important;
        }
    }
}

:not(.ui.grid).only {

  &.mobile:not(.tablet) {
    @media all and (min-width: @tabletBreakpoint) {
      display: none !important;
    }
  }

  &.tablet {
    &.mobile {
      @media all and (min-width: @computerBreakpoint) {
        display: none !important;
      }
    }

    &.computer {
      @media all and (max-width: @largestMobileScreen) {
        display: none !important;
      }
    }

    &:not(.computer):not(.mobile) {
      @media not all and (min-width: @tabletBreakpoint) and (max-width: @largestTabletScreen) {
        display: none !important;
      }
    }
  }

  &.computer:not(.tablet) {
    @media all and (max-width: @largestTabletScreen) {
      display: none !important;
    }
  }
}

button:focus-visible, a:focus-visible {
  outline: 3px solid @focusedFormBorderColor !important;
}

.standard-line-height {
  line-height: normal;
}

.section-title {
  -webkit-font-smoothing: antialiased;
  width: 100%;
  text-align: center;
  display: block;
  color: @primaryColor;
  font-weight: 500;

  h2& {
    font-size: 2em;
    margin-bottom: 3rem;

    @media screen and (max-width: @largestMobileScreen) {
      font-size: 1.7em;
    }
  }

  h3& {
    font-size: 1.5em;

    @media screen and (max-width: @largestMobileScreen) {
      font-size: 1.3em;
    }
  }
}

/* record details */

.font-small {
  font-size: @font-size-small
}

.font-tiny {
  font-size: @font-size-tiny
}

a.no-text-decoration:hover {
  text-decoration: none;
}

a.remove-default-style:hover {
  color: @mutedTextColor;
}

.preview-container {
  border: 1px solid transparent; // Prevents iframe from overflowing accordion border
}

.preview-iframe {
  display: block;
  border-style: none;
  width:100%;
  height:400px;
}


dd {
  // Start left aligned
  margin-inline-start: 0;
}

ul.no-bullet {
  list-style-type: none;
  margin-left: 0 !important;
  padding-left: 0;

  li {
    padding-left: 0 !important;

    &::before {
      content: none !important;
    }
  }
}

ul.details-list {
  li {
    padding-left: 0 !important;

    &:not(:last-child) {
      margin-bottom: 1rem;
    }
  }
}

dl.details-list {
  margin-top: 0;

  &:last-child {
    margin-bottom: 0;
  }

  dt {
    &.ui.tiny.header {
      margin-bottom: 0.2rem;

      &:not(:first-child) {
        margin-top: 1rem;
      }
    }

    &.hidden {
      display: none;
    }
  }

  dd {
    &:not(:last-child) {
      margin-bottom: 0.5rem;
    }

    div:not(:last-child) {
      margin-bottom: 0.25rem;
    }
  }

  &.subjects dd {
    display: inline-block;
    margin-bottom: .4rem;
    margin-right: .1rem;

    &:last-child {
      margin-bottom: 0;
      margin-right: 0;
    }
  }
}

.language {
  font-size: @fontSizeBase;
  font-weight: normal;
}

.truncated {
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.display-inline-flex {
  display: inline-flex;
}

.text-align-center {
  text-align: center !important;
}

.text-align-left {
  text-align: left !important;
}

.text-align-right {
  text-align: right !important;

  &-mobile {
    @media all and (max-width: @largestMobileScreen) {
      text-align: right !important;
    }
  }

  &-tablet {
    @media all and (min-width: @tabletBreakpoint) and (max-width: @largestTabletScreen) {
      text-align: right !important;
    }
  }

  &-computer {
    @media all and (min-width: @computerBreakpoint) {
      text-align: right !important;
    }
  }
}

.inline-computer {
  display: inline-block;

  @media all and (max-width: @largestMobileScreen) {
    display: block;
  }
}

.separated:not(:last-child)::after {
  content: @listSeparator;
  display: inline-block;
  font-size: 1em;
  margin-left: .1rem;
}

.comma-separated:not(:last-child)::after {
  content: @listCommaSeparator;
  display: inline-block;
  font-size: 1em;
}

.highlight-background {
  background-color: @highlightHeaderColor;
}

.selected-background {
  background-color: @selectedColor !important;
}

.text-muted {
  color: @mutedTextColor !important;
}

.clickable {
  cursor: pointer !important;
}

.capitalize-first-char {
  display: inline-block;

  &::first-letter {
    text-transform: capitalize;
  }
}

.sr-only { // Hide element in the UI, but keep it available for screen readers
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  word-wrap: normal;
  border: 0;
}

.themed-community-label {
  font-weight: @normal !important;
  color: @white !important;
  width: 100%;
  height: @26px;
}

.themed-community-logo {
  max-width: 100%;
  max-height: 100%;
}

.text-break {
  word-break: break-word
}


// fix for hidden tooltips
[data-tooltip]:after {
   z-index: 20
}

@media all and (max-width: @largestTabletScreen){
  .right.floated.column {
    [data-tooltip]:hover:after {
      // fix for tooltip overflowing on the right side of mobile devices
      // resulting in cut tooltips
      transform: translateX(-75%) scale(1) !important;
    }
  }
}
// prevent right hand pop up menu to stretch too much
@media all and (max-width: @largestTabletScreen) {
  #invenio-menu {
    width: auto !important;
  }
}

/*******************************
        MBDB Branding
Ported from the old mbdb-app-rdm-12 repository: the Jost typeface, the
light-blue section cards, dark-navy headings and buttons, and the letter
spacing of the old global stylesheet. The Invenio/Semantic-UI components
stay as they are - only their look is adapted.
*******************************/

/* The Jost typeface (the old app's global font) */
@font-face {
  font-family: "Jost";
  font-style: normal;
  font-weight: 300;
  src: url("../fonts/Jost-Light.ttf") format("truetype");
}
@font-face {
  font-family: "Jost";
  font-style: normal;
  font-weight: 400;
  src: url("../fonts/Jost-Regular.ttf") format("truetype");
}
@font-face {
  font-family: "Jost";
  font-style: normal;
  font-weight: 500;
  src: url("../fonts/Jost-Medium.ttf") format("truetype");
}
@font-face {
  font-family: "Jost";
  font-style: normal;
  font-weight: 600;
  src: url("../fonts/Jost-SemiBold.ttf") format("truetype");
}
@font-face {
  font-family: "Jost";
  font-style: normal;
  font-weight: 700;
  src: url("../fonts/Jost-Bold.ttf") format("truetype");
}

body {
  font-family: "Jost", sans-serif;
  letter-spacing: 0.04rem;
}

/* Section cards: the old app's Section/FormWrapper cards were
   #EDF5F8, borderless and slightly rounded (rounded-normal). */
.ui.segment {
  background: @mbdbSectionBackground;
  border: none;
}
/* keep the content of modals on white, like the old form cards */
.ui.modal .ui.segment {
  background: @white;
}

/* Buttons: dark navy with white text (the old app's .ui.button) */
.ui.button,
.ui.button:hover,
.ui.button:focus {
  background-color: @mbdbDark;
  color: @white;
}

/* Headings: dark navy (the old section titles were Jost Medium, #023850) */
.ui.header:not(.inverted) {
  font-family: "Jost", sans-serif;
  color: @mbdbDark;
}
.ui.modal > .header {
  font-family: "Jost", sans-serif;
  color: @mbdbDark;
}

/* Form field labels: navy, like the old deposit form's labels */
.ui.form .field > label {
  color: @mbdbDark;
  font-weight: 500;
}

/* Header: white bar with the logo, centered links and the deposition /
   sign-in actions (the old app's header layout) */
.theme.header {
  box-shadow: none;
}
.theme.header .outer-navbar {
  background: @white;
}
.mbdb-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 1rem 2rem;
  max-width: 1280px;
  margin: 0 auto;
  padding: 1.5rem 3rem;

  a {
    color: @mbdbDark;
  }
  a:hover {
    text-decoration: none;
  }
}
.mbdb-header-logo img {
  width: 5rem;
}
.mbdb-header-links {
  display: flex;
  gap: 4rem;

  a {
    font-size: 1.25rem;
    font-weight: 500;
    transition: transform 300ms ease-in-out;
  }
  a:hover {
    color: @mbdbDark;
    transform: scale(1.1);
  }
}
.mbdb-header-actions {
  display: flex;
  align-items: center;
  gap: 1rem;
}
.mbdb-header .mbdb-header-deposit {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 170px;
  height: 40px;
  white-space: nowrap;
  font-size: 1.125rem;
  color: @white;
  background-color: @mbdbDark;
  border-radius: 0.28571429rem;
  transition: background-color 150ms;

  &:hover {
    color: @white;
    background-color: fade(@mbdbDark, 75%);
  }
}
/* the quick-create "+" menu: not in the old header, and its icons are white */
.mbdb-header #quick-create-dropdown {
  display: none !important;
}
.mbdb-header-signin {
  display: flex;
  align-items: center;
  gap: 0.25rem;

  img {
    height: 40px;
    width: auto;
  }
}
@media all and (min-width: 1440px) {
  .mbdb-header {
    max-width: 1440px;
  }
}
@media all and (max-width: @largestTabletScreen) {
  .mbdb-header {
    padding: 1rem;
  }
  .mbdb-header-links {
    order: 3;
    width: 100%;
    justify-content: center;
    gap: 2rem;
  }
}


/* Landing page and footer (the old app's tailwind sizes and breakpoints) */
.mbdb-landing-width() {
  margin-left: auto;
  margin-right: auto;

  @media all and (min-width: 1024px) {
    max-width: 1024px;
  }
  @media all and (min-width: 1280px) {
    max-width: 1280px;
  }
  @media all and (min-width: 1440px) {
    max-width: 1440px;
  }
}
.mbdb-landing {
  color: @mbdbDark;
  font-size: 1.25rem;
  padding-bottom: 8rem;

  a {
    color: @mbdbDark;
  }
  strong {
    font-weight: 700;
  }
}
.mbdb-landing-hero {
  .mbdb-landing-width();
  position: relative;
  isolation: isolate;
  overflow: hidden;
  padding: 8rem 0;
  text-align: center;

  h1 {
    max-width: 360px;
    margin: 0 auto;
    font-family: "Jost", sans-serif;
    font-size: 2.75rem;
    font-weight: 500;
    line-height: 1.5;
    color: @mbdbDark;
  }
  @media all and (min-width: 640px) {
    h1 {
      max-width: none;
    }
  }
  @media all and (min-width: 1024px) {
    padding: 10rem 0;

    h1 {
      font-size: 4rem;
    }
  }
}
.mbdb-landing-protein-left,
.mbdb-landing-protein-right {
  display: none;
  position: absolute;
  z-index: -1;

  @media all and (min-width: 1280px) {
    display: block;
  }
}
.mbdb-landing-protein-left {
  top: 3rem;
  left: 1rem;
  width: 20rem;

  @media all and (min-width: 1440px) {
    left: 7rem;
  }
}
.mbdb-landing-protein-right {
  top: 10rem;
  right: -1rem;
  width: 22rem;

  @media all and (min-width: 1440px) {
    right: 3rem;
    width: 24rem;
  }
}
.mbdb-landing-search {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  margin: 2rem 1rem;
  font-size: 1rem;

  input, button, select {
    height: 50px;
    letter-spacing: inherit;
    color: @mbdbSectionBackground;
    background-color: @mbdbDark;
    border: none;
    border-radius: 0.5rem;
  }
  input:focus-visible, select:focus-visible {
    outline: 3px solid @focusedFormBorderColor;
  }
  input {
    flex: 1;
    min-width: 0;
    padding: 1rem;
  }
  input::placeholder {
    color: @mbdbGray;
    opacity: 1;
  }
  button {
    width: 50px;
    cursor: pointer;
    transition: background-color 150ms;

    &:hover {
      background-color: fade(@mbdbDark, 75%);
    }
    img {
      width: 1.25rem;
      margin: auto;
    }
  }
  select {
    width: 100%;
    max-width: 358px;
    padding: 0 1rem;
  }
  @media all and (min-width: 640px) {
    flex-direction: row;

    select {
      width: 130px;
    }
  }
  @media all and (min-width: 1024px) {
    select {
      width: 150px;
    }
  }
}
.mbdb-landing-query {
  display: flex;
  gap: 0.5rem;
  width: 100%;
  max-width: 358px;

  @media all and (min-width: 640px) {
    max-width: 432px;
  }
  @media all and (min-width: 1024px) {
    max-width: 647px;
  }
}
.mbdb-landing-search-help {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 1rem;

  a {
    border-bottom: 1px solid @mbdbDark;
  }
  a:hover {
    text-decoration: none;
  }
  @media all and (min-width: 1024px) {
    flex-direction: row;
    justify-content: space-between;
    width: 790px;
    margin: -1rem auto 0;
  }
}
.mbdb-landing-section {
  .mbdb-landing-width();
  padding: 0 2rem;

  @media all and (min-width: 1024px) {
    padding: 0 4rem;
  }
  @media all and (min-width: 1280px) {
    padding: 0 5rem;
  }
  @media all and (min-width: 1440px) {
    padding: 0 4rem;
  }
}
.mbdb-landing-about {
  p {
    margin: 0 0 1rem;
    line-height: 1.5;
  }
  a {
    text-decoration: underline;
  }
  a:hover {
    opacity: 0.7;
  }
  @media all and (min-width: 768px) {
    display: flex;
    gap: 1.5rem;

    > div {
      flex: 1.9;
    }
    > p {
      flex: 1;
    }
  }
}
.mbdb-landing-methods {
  margin-top: 3rem;

  h2 {
    margin: 0 0 1.5rem;
    font-family: "Jost", sans-serif;
    font-size: 2rem;
    font-weight: 500;
    line-height: 1.5;
    color: @mbdbDark;
  }
}
.mbdb-landing-cards {
  display: grid;
  gap: 0.75rem 16px;

  @media all and (min-width: 768px) {
    grid-template-columns: repeat(2, 300px);
  }
  @media all and (min-width: 1024px) {
    grid-template-columns: repeat(3, 300px);
  }

  a {
    position: relative;
    max-width: 300px;
    padding: 3rem 1rem 0.75rem;
    font-weight: 500;
    border: 1px solid @mbdbDark;
    border-radius: 0.28571429rem;
  }
  a:hover {
    text-decoration: none;
    background-color: @mbdbSectionBackground;
  }
  img {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    width: 0.75rem;
    height: 0.75rem;
  }
}
.mbdb-landing-partners {
  .mbdb-landing-width();
  margin-top: 6rem;

  > div {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3rem 4rem;
    margin-bottom: 3rem;

    @media all and (min-width: 768px) {
      flex-direction: row;
    }
  }
  a img {
    width: 12rem;
  }
  a img.ibt {
    width: 11rem;
  }
  > img {
    width: 70%;
    margin: 0 auto;
  }
}
.mbdb-footer {
  background-color: @mbdbDark;
}
.mbdb-footer-inner {
  .mbdb-landing-width();
  padding: 2rem 1rem;
  font-size: 1.25rem;
  font-weight: 300;
  color: @white;

  > div {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0.5rem 0.5rem 1.5rem;
  }
  > .mbdb-footer-title {
    margin: 0 0 1.5rem;
    font-size: 2rem;
    font-weight: 500;
  }
  a {
    font-weight: 400;
    color: @white;
    transition: color 150ms;
  }
  a:hover {
    color: @mbdbYellow;
    text-decoration: none;
  }
  @media all and (min-width: 768px) {
    display: flex;
    justify-content: space-between;
  }
  @media all and (min-width: 1024px) {
    padding: 2rem 3rem;
  }
  @media all and (min-width: 1440px) {
    padding: 5rem;
  }
}
