{# def positions #}

{% for position in array(positions, remove_empty=True) %}
{% set title='Measurement position ' ~ loop.index %}
<div class="mb-4 pb-8 border-b-[.1px] border-b-dark last:border-b-0 last:mb-0">
    <SubSection title={ title }>
        <MeasurementPositionDetailedView position={position} />
    </SubSection>
</div>
{% endfor %}