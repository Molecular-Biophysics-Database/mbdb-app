{# def steps #}

{% for step in array(steps, remove_empty=True) %}
{% set title='Measurement protocol step ' ~ loop.index %}
<div class="mb-4 pb-8 border-b-[.1px] border-b-dark last:border-b-0 last:mb-0">
    <SubSection title={ title }>
        <MeasurementProtocolStepDetailedView step={step} />
    </SubSection>
</div>
{% endfor %}