{# def entity #}

<ExternalDatabases external_databases={entity.external_databases} />

<AdditionalSpecifications additional_specifications={entity.additional_specifications} />

<IField label="Molecular weight" d={entity.molecular_weight}>
    <ValueUnit value={entity.molecular_weight} />
</IField>

<IField label="Modifications" d={entity.chemical_modifications} >
    <ModificationsDetailedView modifications={entity.chemical_modifications} />
</IField>

{% for component in array(entity.components) %}

{% set title='Component ' ~ loop.index %}
    <SubSection title={ title }>
        <IField label="Copy Number" d={component.copy_number} />
        <EntityDetailedView entity={component} />
    </SubSection>
{% endfor %}