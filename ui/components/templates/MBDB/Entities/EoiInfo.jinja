{# def gp, eoi_refs #}

{# Recordview template that references to entities with their concentration (in measurements) #}

{% for eoi_ref in array(eoi_refs) %}
    {% set eoi=find_reference(gp.entities_of_interest, eoi_ref.entity.id) %}
    <div>
        {{ eoi.name }}
        <ValueUnit value={eoi_ref.concentration} />
    </div>
{% endfor %}

