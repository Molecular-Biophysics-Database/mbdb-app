{# def entity #}

<IField label="Pubchem Title" d={entity.basic_information.title} />
<IField label="Molecular weight" d={entity.molecular_weight}>
    <ValueUnit value={entity.molecular_weight} />
</IField>
<IField label="InChI key" d={entity.basic_information}>
    {% if entity.basic_information %}
        {{ entity.basic_information.id._ui_value[9:] }}
    {% endif %}
</IField>