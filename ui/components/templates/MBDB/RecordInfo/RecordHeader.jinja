{# def record, md, links, state, permissions, embedded, pdf_embedded=false #}
{% set pdf_embedded = request.args.get("pdf_embedded", "false")|lower == "true" %}

{# Recordview template that renders the
  1. The state (status) of the record (draft, submitted...)
  2. The title of the record
  3. The buttons (including requests) (delete, edit, download publish draft)
 #}

{# render the state of the record #}
<Status state={ state } />

<div class="flex justify-between mb-8">
{# render the title of the record #}
  <div class="font-JostMedium text-30px lg:text-40px">
    <IValue value={ md.general_parameters.record_information.title } placeholder="(Record has no title)" />
  </div>
{% if not pdf_embedded and not embedded %}
{# render template (duplicate) button #}
  <div class="flex">
    <div class="mr-1">
      <TemplateButton self_link={ links.self } />
    </div>
{# render download button #}
    <div class="mr-1">
      <a class="flex justify-center px-4 h-10 text-20px bg-dark rounded-normal text-white hover:text-white hover:bg-dark/75 transition-all"
        href="{{links.export_path}}/json?prettyprint=1" type="application/json" role="button">
        <button class="px-4">
          Download
        </button>
      </a>
    </div>
{# render edit button if user has permission to edit the draft #}
    {% if permissions.can_update %}
    <div class="mr-1">
      <a class="flex justify-center px-8 h-10 text-20px bg-dark rounded-normal text-white hover:text-white hover:bg-dark/75 transition-all"
        href="{{ links.edit_html or links.self_html }}" type="application/json" role="button">
        <button class="px-4">
          Edit
        </button>
      </a>
    </div>
    {% endif %}
{# render all request buttons (via Oarepo template) #}
    <RecordRequests record={ record } />
{# render delete button is user has permission to delete the draft #}
    {% if permissions.can_delete %}
    <RemoveButton self_link={ links.self } state={ state } />
    {% endif %}
  </div>
{% endif %}
</div>