{# def d, gp #}

{# Recordview template that renders the record information (at the beginning of
the record view. This includes
 1. The DOI (or expected DOI if the record is not published yet)
 2. The MBDB id
 3. The depositors
 4. The associated publication
 5. The license information
 6. The funding information
 7. The method

Note that title and state/status is not rendered by this component #}

<IValueList>
    {% if d.state._ui_value == "published" %}
        <IField d={gp.record_information.external_identifier} label="DOI"  />
    {% else %}
        <IField d={d.id} label="Expected DOI" >
            <ExpectedDoi id={d.id} />
        </IField>
    {% endif %}
    <IField d={d.id} label="Record ID"  />
    <IField d={gp.record_information.date_available} label="Publication date"  />
    <IField d={gp.depositors}>
        <Depositors depositors={gp.depositors} />
    </IField>
    <IField d={gp.associated_publication}>
        <AssociatedPublication publication={gp.associated_publication} />
    </IField>
    <IField d={gp.record_information.license} >
        <License license={gp.record_information.license} />
    </IField>
    <IField d={gp.funding_references} >
        <Funding funding_refs={gp.funding_references} />
    </IField>
    <IField d={gp.method} />
</IValueList>