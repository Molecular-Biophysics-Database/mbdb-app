{# def measurements #}

{% for measurement in array(measurements, remove_empty=True) %}
{% set title='Measurement ' ~ loop.index %}
<div class="mb-4 pb-8 border-b-[.1px] border-b-dark last:border-b-0 last:mb-0">
    <SubSection title={ title }>
        <BLIMeasurementDetailedView measurement={measurement} />
    </SubSection>
</div>
{% endfor %}