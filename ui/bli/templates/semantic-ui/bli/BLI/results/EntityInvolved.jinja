{# def entities #}

<IField label="Entities involved">
    <INonEmpty d={entities}>
        {%- for entity in array(entities) %}
            <div class="font-JostBold mb-2">Entity involved {{ loop.index }}</div>
            <div class='ml-4'>
                <IField label="Entity" d={entity.entity.name}/>
                <IField label="Copy number" d={entity.copy_number} />
            </div>
        {%- endfor%}
    </INonEmpty>
</IField>
