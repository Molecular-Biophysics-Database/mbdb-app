{# def sensors #}

{% for sensor in array(sensors, remove_empty=True) %}
{% set title='Sensor ' ~ loop.index %}
<div class="mb-4 pb-8 border-b-[.1px] border-b-dark last:border-b-0 last:mb-0">
    <SubSection title={ title }>
        <SensorDetailedView sensor={sensor} />
    </SubSection>
</div>
{% endfor %}