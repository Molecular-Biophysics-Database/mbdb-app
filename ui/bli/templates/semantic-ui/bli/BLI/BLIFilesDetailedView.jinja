{# def files #}

{% for file in files.entries %}
    {% set title='File ' ~ loop.index %}
    <div class="mb-4 pb-8 border-b-[.1px] border-b-dark last:border-b-0 last:mb-0">
        <SubSection title={ title }>
            <IField label="Context" d={file.metadata.context} />
            <a class="flex justify-center w-fit py-2 px-4 mb-2 text-18px bg-dark rounded-normal text-white hover:bg-secondary hover:text-dark transition-all" href="{{file.links.content}}" target="_blank">
                Download {{ file.key }}
            </a>
        </SubSection>
    </div>
{% endfor %}